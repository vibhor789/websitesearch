# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets (Path to your service account JSON file)
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Proxy Settings (Optional - for IP rotation)
USE_PROXY=false
PROXY_LIST_FILE=proxies.txt
PROXY_TYPE=http  # http, socks5, or rotating_service

# ScraperAPI (Alternative to proxies - recommended for beginners)
USE_SCRAPER_API=false
SCRAPER_API_KEY=your_scraper_api_key_here

# Search Settings
MAX_SEARCH_RESULTS=10
SEARCH_DELAY_MIN=2
SEARCH_DELAY_MAX=5

# Website Analysis
PAGE_LOAD_TIMEOUT=30
SCREENSHOT_ENABLED=true
